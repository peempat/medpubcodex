# TEMPLATE ONLY - DO NOT PUT A REAL TOKEN IN THIS FILE.
# This file is committed to git. A real token pasted here will be pushed.
#
# Copy it first, then edit the copy:
#   PowerShell : Copy-Item webapp\.env.example webapp\.env
#   Linux/macOS: cp webapp/.env.example webapp/.env
# webapp/.env is git-ignored and is the only place a real token belongs.

# Hugging Face access token with READ permission.
# Needed because:
#   - google/gemma-4-*  and google/medgemma-* are gated repositories
#   - the quantized BitsAndBytes checkpoints were pushed as PRIVATE repos
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_replace_me

# Optional: Gradio server binding.
# GRADIO_SERVER_NAME=127.0.0.1
# GRADIO_SERVER_PORT=7860
# GRADIO_SHARE=false
